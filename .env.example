# Elly — environment template. Copy to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored; NEVER commit real keys (SEC-004). Values here are placeholders.
# Loading: `python -m elly` loads `.env` into the environment at startup (non-overriding:
# a real shell/CI env var wins). Empty values are ignored.

# --- OpenAI (M0 feasibility smoke; M5 specialist adapter + hosted web_search) ---
# Get a key from your OpenAI account. Used only when a cloud call is authorized.
OPENAI_API_KEY=

# Provider/model/pricing choices belong in config.local.toml. Keep this file for
# secrets and exceptional deployment overrides only.

# --- Optional app-config overrides (see config.example.toml) ---
# ELLY_DB_PATH=data/elly.db
# ELLY_LOG_LEVEL=INFO

# NOTE: No Brave key is needed — web research uses OpenAI hosted web_search (DEC-OQ-07).
